<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/|admin/|licensing_server/).*)$ public/$1 [L]
</IfModule>

# Prevent direct index browsing
Options -Indexes

# Block direct access to all sensitive files and extensions
<FilesMatch "^\.env|\.(env|pem|key|sqlite|sqlite3|db|sql|log|bak|tmp|dump)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
