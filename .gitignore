# ==============================================================================
# GroCo Grocery Store — Production-Safe & Security-Hardened .gitignore
# ==============================================================================
# Designed specifically for the GroCo PHP / MySQL E-Commerce & Retail ERP Platform.
# Guarantees zero secret leakage (RSA private keys, SQLite authority databases,
# environment variables, customer uploads, financial dumps, and session logs),
# while strictly preserving all application source code, configs, migrations,
# test suites, and frontend asset directories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Secrets & Configuration
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
config.local.php
config.private.php
database.local.php
db.local.php
local.php
auth.json
secrets/
private/
credentials/
*.secret
*.secret.*

# ------------------------------------------------------------------------------
# 2. Cryptographic Keys, Certificates & Authority Databases
# ------------------------------------------------------------------------------
# Licensing authority SQLite database and private RSA signing keys
licensing_server/data/
licensing_server/*.pem
licensing_server/*.key
licensing_server/*.sqlite
licensing_server/*.sqlite3
licensing_server/*.db
license_private.pem
authority_private.pem

# Generic private keys and certificates (preserves public distribution keys)
*.key
*.pem
*.pfx
*.p12
*.crt
*.cer
*.der
*.csr
*.jks
storage/*.key
storage/install_id.key

# SQLite database files
*.sqlite
*.sqlite3
*.db
*.sdb

# ------------------------------------------------------------------------------
# 3. Runtime Storage, Logs, Caches & Sessions
# ------------------------------------------------------------------------------
# Storage directory runtime artifacts
storage/logs/**
!storage/logs/**/
!storage/logs/**/.gitkeep

storage/cache/**
!storage/cache/**/
!storage/cache/**/.gitkeep

storage/backups/**
!storage/backups/**/
!storage/backups/**/.gitkeep

# User & customer uploads (avatars, reviews, product galleries, categories, banners)
storage/uploads/**
!storage/uploads/**/
!storage/uploads/**/.gitkeep

# Public runtime uploads & error logs
public/logs/**
!public/logs/**/
!public/logs/.htaccess
!public/logs/**/.gitkeep

public/uploads/**
!public/uploads/**/
!public/uploads/.htaccess
!public/uploads/**/.gitkeep

# Admin runtime uploads
admin/uploads/**
!admin/uploads/**/
!admin/uploads/**/.gitkeep

# General log & session files
*.log
*.log.*
sess_*
session_*

# General cache & temporary runtime files
*.cache
*.tmp
*.temp
cache/
tmp/
temp/
scratch/

# ------------------------------------------------------------------------------
# 4. Database Backups, Dumps & Ad-hoc Exports
# ------------------------------------------------------------------------------
# Prevent accidental upload of production database dumps containing real customer data
*.dump
*.bak
*.bak.sql
*.backup.sql
*.tmp.sql
*.export.sql
database/backups/
database/backup/
database/dumps/
backups/

# Ignore duplicate/adhoc dump copies, order exports, and external data archives
database/* (1).sql
database/*.bak
database/*.csv
database/archive.zip

# ------------------------------------------------------------------------------
# 5. Generated Reports & Data Exports
# ------------------------------------------------------------------------------
admin/reports/exports/*.csv
admin/reports/exports/*.pdf
admin/reports/exports/*.xlsx
storage/exports/
*.export.csv

# ------------------------------------------------------------------------------
# 6. Test Artifacts, Scratch Scripts & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.phpunit.result.cache
test-results/
playwright-report/
screenshots/
*.test.log

# ------------------------------------------------------------------------------
# 7. PHP / Composer & Node Dependencies
# ------------------------------------------------------------------------------
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 8. IDE, Editor & Workspace Metadata
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.history/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 9. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.stackdump

# ------------------------------------------------------------------------------
# 10. Explicit Preservation of Essential Architecture Schemas & Test Suites
# ------------------------------------------------------------------------------
# Guarantee all Apache configuration files are NEVER ignored
!.htaccess
!public/.htaccess
!storage/.htaccess
!database/.htaccess
!public/logs/.htaccess
!public/uploads/.htaccess

# Guarantee permanent static placeholder images and assets are tracked
!public/assets/images/**
!public/assets/icons/**
!public/assets/fonts/**

# Guarantee core database migration SQL schemas are tracked
!database/pos_erp_migrations.sql
!database/license_migrations.sql

# Guarantee all regression & security test suites are tracked
!admin_full_audit_test.php
!admin_db_integrity_scan.php
!tests/licensing_system_test.php
!tests/licensing_security_hardening_test.php
!docs/LICENSING_SYSTEM.md
