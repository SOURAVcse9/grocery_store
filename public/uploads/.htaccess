# ==============================================================================
# public/uploads/.htaccess — Disable Script Execution in Uploads
# ==============================================================================
Options -Indexes -ExecCGI

# Deny execution of all executable scripts and configuration files
<FilesMatch "(?i)\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh|bash|exe|asp|aspx|shtml|env|config|htaccess)$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP Engine if running as Apache module
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
