# ==============================================================================
# public/uploads/.htaccess — Anti-Webshell & Upload Security Protection
# ==============================================================================

# Disable directory listing and script execution
Options -Indexes -ExecCGI

# Deny execution of PHP, scripts, or executables in uploads
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|pl|py|cgi|sh|bash|exe|bat|cmd)$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Only allow safe static image and media MIME types
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .inc
</IfModule>
