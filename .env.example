# ==============================================================================
# GroCo Grocery Store — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust the settings according to your environment.
# DO NOT commit real passwords, API keys, or production credentials to GitHub!
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080/grocery-store

# Database Configuration (PDO MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=grocery_store
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Mail / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@groco.com.bd
MAIL_FROM_NAME="GroCo Grocery Store"

# Security & Sessions
SESSION_LIFETIME=0
SESSION_SECURE_COOKIE=false
CSRF_SECRET_KEY=replace_with_a_secure_random_64_character_hex_token
