# ==============================================================================
# GroCo Grocery Store — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your production credentials.
# NEVER commit your real .env file or production secrets to Git!
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com

# Database Configuration (MySQL 8 / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=grocery_store
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Mail / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@example.com
MAIL_FROM_NAME="GroCo Grocery Store"

# Security & Sessions
SESSION_LIFETIME=0
SESSION_TIMEOUT=7200
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax
CSRF_SECRET_KEY=generate_a_64_character_random_hex_secret_key_here

# Analytics & Webmaster Verification
GA_MEASUREMENT_ID=
GSC_VERIFICATION_TOKEN=

# Software Licensing & Activation Server
LICENSE_SERVER_URL=https://license.groco.com.bd/api.php
LICENSE_GRACE_PERIOD_DAYS=7

# Google OAuth 2.0 / OpenID Connect (Customer Authentication)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://example.com/public/auth/google-callback.php

# ==============================================================================
# Cloudinary CDN & High-Performance Image Optimization
# ==============================================================================
# Obtain credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional full URL format: cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_URL=

# ==============================================================================
# SSLCOMMERZ V4 Payment Gateway Integration
# ==============================================================================
# Sandbox Store ID and Password for development/testing:
# Default test store credentials: testbox / qwerty
PAYMENT_ENV=sandbox
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_CURRENCY=BDT
SSLCOMMERZ_SUCCESS_URL=https://example.com/public/payment/sslcommerz/success.php
SSLCOMMERZ_FAIL_URL=https://example.com/public/payment/sslcommerz/fail.php
SSLCOMMERZ_CANCEL_URL=https://example.com/public/payment/sslcommerz/cancel.php
SSLCOMMERZ_IPN_URL=https://example.com/public/payment/sslcommerz/ipn.php

