# ==============================================================================
# GroCo Grocery Store — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your production credentials.
# NEVER commit your real .env file or production secrets to Git!
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-grocery-domain.com

# Database Configuration (MySQL / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=grocery_store
DB_USER=your_db_username
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Mail / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@your-grocery-domain.com
MAIL_FROM_NAME="GroCo Grocery Store"

# Security & Sessions
SESSION_LIFETIME=0
SESSION_SECURE_COOKIE=true
CSRF_SECRET_KEY=generate_a_64_character_random_hex_secret_key_here

# Software Licensing & Activation Server
LICENSE_SERVER_URL=https://license.groco.com.bd/api.php
LICENSE_GRACE_PERIOD_DAYS=7

# Google OAuth 2.0 / OpenID Connect (Customer Authentication)
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-grocery-domain.com/public/auth/google-callback.php
